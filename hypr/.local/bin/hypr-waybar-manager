#!/usr/bin/env bash

set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
base_config="$HOME/.config/waybar/themes/default/config"
style="$HOME/.config/waybar/themes/default/style.css"
parked_panel_file="$runtime_dir/hypr-lid-parked-panel"
state_file="$runtime_dir/hypr-waybar-topology"
pid_file="$runtime_dir/hypr-waybar-pids"
config_dir="$runtime_dir/hypr-waybar-config"
groups="${HYPR_WAYBAR_PERSISTENT_GROUPS:-2}"

usage() { echo "Usage: $(basename "$0") {start|reconcile|restart|stop}" >&2; exit 2; }

visible_monitors() {
    local parked=""
    [[ -r "$parked_panel_file" ]] && read -r parked < "$parked_panel_file" || true
    hyprctl monitors -j | jq -r --arg parked "$parked" '
      map(select(.disabled != true and .name != $parked))
      | sort_by(.x, .y, .name)
      | .[].name
    '
}

bars_running() {
    local pid seen=false
    [[ -r "$pid_file" ]] || return 1
    while read -r pid; do
        [[ -n "$pid" ]] || continue
        seen=true
        kill -0 "$pid" 2>/dev/null || return 1
    done < "$pid_file"
    "$seen"
}

stop() {
    local pid
    if [[ -r "$pid_file" ]]; then
        while read -r pid; do
            [[ -n "$pid" ]] && kill "$pid" 2>/dev/null || true
        done < "$pid_file"
    fi
    rm -f "$pid_file" "$state_file"
}

workspace_slots() {
    local slot="$1" count="$2" group slots=()
    for ((group = 0; group < groups; group++)); do
        slots+=("$((group * count + slot + 1))")
    done
    local IFS=,
    printf '[%s]' "${slots[*]}"
}

write_config() {
    local output="$1" slots="$2" destination="$3" output_json
    output_json="$(jq -Rn --arg value "$output" '$value')"
    awk -v output="$output_json" -v slots="$slots" '
      NR == 1 { print; print "    \"output\": " output ","; next }
      /^[[:space:]]*"format": "\{name\}  \{windows\}",/ {
          print
          print "        \"persistent-workspaces\": { " output ": " slots " },"
          next
      }
      { print }
    ' "$base_config" > "$destination"
}

reconcile() {
    [[ -r "$base_config" && -r "$style" ]] || return 0
    [[ "$groups" =~ ^[1-9][0-9]*$ ]] || { echo 'HYPR_WAYBAR_PERSISTENT_GROUPS must be a positive integer' >&2; return 2; }

    local monitors=() monitor count signature slot config
    mapfile -t monitors < <(visible_monitors)
    count="${#monitors[@]}"
    ((count)) || return 0
    signature="${groups}:$(printf '%s\n' "${monitors[@]}")"
    if [[ -r "$state_file" && "$(<"$state_file")" == "$signature" ]] && bars_running; then return 0; fi

    stop
    mkdir -p "$config_dir"
    : > "$pid_file"
    for slot in "${!monitors[@]}"; do
        monitor="${monitors[$slot]}"
        config="$config_dir/${monitor}.jsonc"
        write_config "$monitor" "$(workspace_slots "$slot" "$count")" "$config"
        waybar -c "$config" -s "$style" </dev/null >/dev/null 2>&1 &
        printf '%s\n' "$!" >> "$pid_file"
    done
    printf '%s\n' "$signature" > "$state_file"
}

main() {
    local action="${1:-}"
    case "$action" in
        start|reconcile) reconcile ;;
        restart) stop; reconcile ;;
        stop) stop ;;
        *) usage ;;
    esac
}

main "$@"
