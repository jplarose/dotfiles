#!/usr/bin/env python3
"""Place the laptop panel at either end of the existing external layout."""

import argparse
import fcntl
import json
import math
import os
from pathlib import Path
import subprocess
import sys
import time


def run(*command):
    return subprocess.run(command, check=True, capture_output=True, text=True,
                          timeout=30).stdout


def state_path():
    return Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "hypr/monitor-side"


def saved_side(path):
    try:
        side = path.read_text().strip()
    except FileNotFoundError:
        return "left"
    if side not in ("left", "right"):
        raise ValueError(f"Invalid laptop side in {path}: {side!r}")
    return side


def logical_width(monitor):
    dimension = "height" if monitor.get("transform", 0) % 2 else "width"
    width = monitor[dimension] / monitor["scale"]
    if not math.isfinite(width) or width <= 0:
        raise ValueError(f"Invalid geometry for {monitor['name']}")
    return math.ceil(width)


def target_layout(monitors, laptop_name, side):
    active = [m for m in monitors if not m.get("disabled") and m["name"] != "FALLBACK"]
    laptop = next((m for m in active if m["name"] == laptop_name), None)
    if laptop is None:
        return []
    external = [m for m in active if m["name"] != laptop_name
                and m.get("mirrorOf", "none") in ("none", "", None)]
    if not external:
        return [(laptop, 0, 0)]
    # A single travel display has no dock ordering to preserve. Anchor the
    # pair at zero, including recovery from a previous auto-placement drift.
    if len(external) == 1:
        screen = external[0]
        if side == "left":
            return [(screen, logical_width(laptop), 0), (laptop, 0, 0)]
        return [(screen, 0, 0), (laptop, logical_width(screen), 0)]
    if side == "left":
        edge = min(external, key=lambda m: m["x"])
        x = edge["x"] - logical_width(laptop)
    else:
        edge = max(external, key=lambda m: m["x"] + logical_width(m))
        x = edge["x"] + logical_width(edge)
    return [(m, m["x"], m["y"]) for m in external] + [(laptop, x, edge["y"])]


def target_position(monitors, laptop_name, side):
    targets = target_layout(monitors, laptop_name, side)
    return targets[-1] if targets else None


def monitor_rule(monitor, x, y):
    mode = f"{monitor['width']}x{monitor['height']}@{monitor['refreshRate']}"
    return ("hl.monitor({ output = " + json.dumps(monitor["name"])
            + ", mode = " + json.dumps(mode)
            + ", position = " + json.dumps(f"{x}x{y}")
            + f", scale = {monitor['scale']}, transform = {monitor.get('transform', 0)}" + " })")


def apply(side, dry_run=False):
    name = os.environ.get("HYPR_LAPTOP_MONITOR", "eDP-1")
    targets = target_layout(json.loads(run("hyprctl", "monitors", "all", "-j")), name, side)
    if not targets:
        if dry_run:
            print("No active laptop panel; leaving layout alone")
        return
    if dry_run:
        for monitor, x, y in targets:
            print(f"{monitor['name']}: {side} -> {x}x{y}")
        return
    if all((m["x"], m["y"]) == (x, y) for m, x, y in targets):
        return
    # Pin ALL participating outputs, including ones already at their targets.
    # Leaving an external rule on `auto` makes it follow the moving panel and
    # creates an endless layout_changed/reconcile feedback loop.
    lua = "\n".join(monitor_rule(m, x, y) for m, x, y in targets)
    response = run("hyprctl", "eval", lua).strip()
    if response != "ok":
        raise ValueError(f"Hyprland rejected laptop position: {response}")
    # Workspace ownership uses monitor order; wait until IPC reflects the move.
    for _ in range(20):
        current = json.loads(run("hyprctl", "monitors", "all", "-j"))
        positions = {m["name"]: (m["x"], m["y"]) for m in current}
        if all(positions.get(m["name"]) == (x, y) for m, x, y in targets):
            return
        time.sleep(0.1)
    raise ValueError("Laptop position did not settle; a later monitor event will retry")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("left", "right", "toggle", "apply", "status"))
    parser.add_argument("--dry-run", action="store_true", help="Preview without saving or moving displays")
    args = parser.parse_args()
    try:
        path = state_path()
        if args.action in ("apply", "status") or args.dry_run:
            side = saved_side(path)
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            with path.with_suffix(".lock").open("w") as lock:
                fcntl.flock(lock, fcntl.LOCK_EX)
                side = saved_side(path)
                side = ("right" if side == "left" else "left") if args.action == "toggle" else args.action
                temporary = path.with_suffix(".tmp")
                temporary.write_text(side + "\n")
                temporary.replace(path)
            # The lid manager serializes layout/power/workspace transitions and
            # calls our apply action before updating workspace ownership.
            run("hypr-lid-manager", "reconcile")
            print(f"Laptop screen: {side}")
            return 0
        if args.action == "status":
            print(side)
        else:
            if args.dry_run and args.action in ("left", "right", "toggle"):
                side = ("right" if side == "left" else "left") if args.action == "toggle" else args.action
            apply(side, args.dry_run)
    except (OSError, ValueError, KeyError, ZeroDivisionError, subprocess.SubprocessError) as error:
        print(f"hypr-monitor-layout: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
